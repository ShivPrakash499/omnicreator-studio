# ==============================================================================
# OMNI STUDIO — Generic Multi-Niche Multi-Agent AI Video Engine
# Environment Configuration Template (.env.example)
# ==============================================================================

# 1. Google Gemini API (Official google-genai SDK / Interactions API)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional Model Overrides (Defaults use latest Paid Tier 1 / Ultra models)
SCRIPT_MODEL="gemini-4-carbon"
REASONING_MODEL="gemini-4-argon"
FAST_MODEL="gemini-3.8-flash"
IMAGE_MODEL="gemini-3-pro-image"
IMAGE_CONTINUITY_MODEL="gemini-nano-banana-2.1"
VIDEO_MODEL="gemini-omni-1.2-flash"
TTS_MODEL="gemini-3.8-flash-tts"
TRANSCRIBE_MODEL="gemini-3.5-transcribe"
MUSIC_MODEL="lyria-3.5"

# 2. Priority 1: Vertex AI ADC / Google AI Ultra Cloud Credits (Recommended!)
# Works locally via `config/credentials/vertex_adc.json` or gcloud ADC, and on Streamlit Cloud via `VERTEX_ADC_JSON` secret.
GOOGLE_CLOUD_PROJECT="gen-lang-client-0777980903"
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS="config/credentials/vertex_adc.json"
VERTEX_ADC_JSON=""
VERTEX_VEO_MODEL="veo-3.1-generate-001"
USE_CLOUD_TTS_CHIRP3="false"

# 3. YouTube Data API v3 & Direct Publisher OAuth 2.0
# Scope: https://www.googleapis.com/auth/youtube.upload + youtube.readonly
YOUTUBE_API_KEY="your_youtube_data_api_v3_key"
YOUTUBE_CLIENT_SECRETS_FILE="config/credentials/client_secret.json"
YOUTUBE_TOKEN_FILE="config/credentials/youtube_oauth_token.json"
YOUTUBE_REDIRECT_URI="http://localhost:8501"

# 4. Creator Likeness & Thumbnail Branding (@jwalashiva)
CREATOR_HANDLE="@jwalashiva"
LIKENESS_DIR="assets/likeness"

# 5. Local Storage, SQLite Queue & Render Engine Settings
OMNI_DB_PATH="storage/omni_studio.db"
OMNI_PROJECTS_DIR="storage/projects"
OMNI_VIDEO_RESOLUTION="1080p"
OMNI_VIDEO_FPS="24"
OMNI_BGM_DUCK_DB="-24.0"
OMNI_MAX_WORKERS="4"
