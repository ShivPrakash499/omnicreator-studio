# ==============================================================================
# OMNI CREATOR — Ultra-Realistic 3D Hinglish Science Video & SEO Engine (Classes 9-12)
# Environment Configuration Template (.env.example)
# ==============================================================================

# 1. Google Gemini API & Interactions SDK (Paid Tier 1 / Ultra Models)
# Powers: gemini-4-carbon, gemini-4-argon, gemini-4-hydrogen, gemini-3-pro-image,
#         gemini-nano-banana-2.1, gemini-omni-1.2-flash, gemini-3.8-flash-tts,
#         gemini-3.5-transcribe, and lyria-3.5
GEMINI_API_KEY="your_gemini_paid_tier1_api_key_here"
GOOGLE_CLOUD_PROJECT="gen-lang-client-0777980903"

# 2. Google Ads API (KeywordPlanIdeaService — Google Keyword Planner)
# Geo-targeted to India (2356), Languages: English (1000) + Hindi (1023)
# Note: If omitted, seo_keyword_engine.py automatically activates its clean fallback
# using YouTube India Autocomplete + Google Trends (pytrends) + gemini-4-carbon Search Grounding.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_CUSTOMER_ID=""

# 3. YouTube Data API v3 (Optional — enhances competitor & search volume metrics)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="UCuYzy1OoXmzIdjRP8cgUmRw"

# 4. Google Drive Auto-Archive Hierarchy (Youtube -> TopperLAB -> <Video Title>)
GDRIVE_TOPPERLAB_FOLDER_ID="1JYZ4Vbm-qeVcOYVNIyruLtIKCBGRhaJa"

# 5. Omni Creator Studio Pipeline Settings
OMNI_DEFAULT_RESOLUTION="4k"
OMNI_DEFAULT_FPS="24"
OMNI_BGM_DUCK_DB="-22"
OMNI_CACHE_DIR="workspaces/omni_cache"
OMNI_OUTPUT_DIR="output"
